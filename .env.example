NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Supabase Service Role Key (Variable Serveur STRICTE - Ne JAMAIS exposer côté client avec NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Moneriz Payment Gateway (Variables Serveur - Ne JAMAIS exposer côté client)
MONERIZ_SECRET_KEY=izp_live_sk_votre_cle_secrete
MONERIZ_WEBHOOK_SECRET=votre_secret_webhook

# Cloudflare Turnstile Anti-Bot (Optionnel - la protection heuristique locale reste active par défaut)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=votre_turnstile_site_key
TURNSTILE_SECRET_KEY=votre_turnstile_secret_key

# Cloudflare R2 Storage (Stockage d'images et reçus compatible S3)
CLOUDFLARE_R2_ACCOUNT_ID=votre_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=votre_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=votre_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=boutiquepro-uploads
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://cdn.boutiquepro.app

# Resend Emails (Transactional Outbox Pattern)
RESEND_API_KEY=re_votre_cle_resend
EMAIL_FROM="BoutiquePro <notifications@boutiquepro.app>"

# Vercel Crons Secret (Protection des endpoints de tâches planifiées)
CRON_SECRET=votre_cle_secrete_cron_longue_et_aleatoire

# Sentry Monitoring (Télémétrie & Traçabilité des Erreurs)
NEXT_PUBLIC_SENTRY_DSN=https://cle_publique@o123456.ingest.sentry.io/123456

# Google OAuth Client ID (Google Identity Services)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=667335117568-kuqmmr2o3qbfg7h0up8rl7t8jtnu45sj.apps.googleusercontent.com
