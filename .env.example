NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Supabase Service Role Key (Variable Serveur STRICTE - Ne JAMAIS exposer côté client avec NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Moneriz Payment Gateway (Variables Serveur - Ne JAMAIS exposer côté client)
MONERIZ_SECRET_KEY=izp_live_sk_votre_cle_secrete
MONERIZ_WEBHOOK_SECRET=votre_secret_webhook

# Cloudflare Turnstile Anti-Bot (Optionnel - la protection heuristique locale reste active par défaut)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=votre_turnstile_site_key
TURNSTILE_SECRET_KEY=votre_turnstile_secret_key
